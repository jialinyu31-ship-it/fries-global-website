# Public canonical URL used for metadata and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Comma-separated hostnames accepted by the origin in addition to localhost.
ALLOWED_HOSTS=www.example.com,example.com

# Never place admin passwords, session secrets, tunnel tokens or forensic keys
# in this file. Run `npm run admin:init` locally; generated credentials remain
# under ignored local files and must be configured as deployment secrets.
